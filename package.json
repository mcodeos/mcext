{
	"name": "mcode",
	"displayName": "MCode",
	"description": "mcode language server",
	"publisher": "MCode",
	"license": "MIT",
	"version": "0.5.2",
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"language-server",
		"tower-lsp",
		"mcode"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/mcodels/mcext.git"
	},
	"engines": {
		"vscode": "^1.66.0"
	},
	"enabledApiProposals": [],
	"activationEvents": [
		"onLanguage:mcode",
		"onCommand:mcode.previewViz",
		"onCommand:mcode.build",
		"onCustomEditor:mcode.viz"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "mcode.previewViz",
				"title": "MCode: Preview Circuit (viz)",
				"category": "MCode",
				"icon": "$(circuit-board)"
			},
			{
				"command": "mcode.build",
				"title": "MCode: Build Project",
				"category": "MCode",
				"icon": "$(tools)"
			},
			{
				"command": "mcode.checkFile",
				"title": "MCode: Check Current File",
				"category": "MCode",
				"icon": "$(checklist)"
			},
			{
				"command": "mcode.explainCode",
				"title": "MCode: Explain Error Code",
				"category": "MCode"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "mcode.previewViz",
					"when": "resourceLangId == mcode",
					"group": "navigation"
				},
				{
					"command": "mcode.build",
					"when": "resourceLangId == mcode",
					"group": "navigation"
				}
			],
			"statusBar": [
				{
					"command": "mcode.build",
					"when": "resourceLangId == mcode"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "mcode.viz",
				"displayName": "MCode Circuit Preview",
				"selector": [
					{
						"filenamePattern": "*.mc"
					}
				],
				"priority": "option"
			}
		],
		"languages": [
			{
				"id": "mcode",
				"extensions": [
					".mc"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"snippets": [
			{
				"language": "mcode",
				"path": "./snippets/mcode.json"
			}
		],
		"grammars": [
			{
				"language": "mcode",
				"scopeName": "source.mcode",
				"path": "./syntaxes/mcode.tmLanguage.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "mcodels",
			"properties": {
				"mcodels.systemRoot": {
					"type": "string",
					"scope": "window",
					"description": "MCode system library root (searched for `use` targets like `mclibs.power`; falls back to ~/.mcode)."
				},
				"mcodels.projectRoot": {
					"type": "string",
					"scope": "window",
					"description": "MCode project root; defaults to the first workspace folder."
				},
				"mcodels.semanticTokensEnabled": {
					"type": "boolean",
					"scope": "resource",
					"default": true,
					"description": "Enable semantic token highlighting."
				},
				"mcodels.inlayHintsEnabled": {
					"type": "boolean",
					"scope": "resource",
					"default": true,
					"description": "Enable inlay hints."
				},
				"mcodels.diagnosticsDebounceMs": {
					"type": "number",
					"scope": "resource",
					"default": 150,
					"description": "Debounce interval (ms) before republishing diagnostics after an edit."
				},
				"mcodels.formatTabSize": {
					"type": "number",
					"scope": "resource",
					"default": 4,
					"description": "Indent size used by document formatting."
				},
				"mcodels.formatInsertFinalNewline": {
					"type": "boolean",
					"scope": "resource",
					"default": true,
					"description": "Insert a final newline when formatting."
				}
			}
		},
		"keybindings": [
			{
				"command": "mcode.build",
				"key": "ctrl+alt+b",
				"mac": "ctrl+alt+b",
				"when": "editorLangId == mcode"
			},
			{
				"command": "mcode.checkFile",
				"key": "ctrl+alt+c",
				"mac": "ctrl+alt+c",
				"when": "editorLangId == mcode"
			},
			{
				"command": "mcode.explainCode",
				"key": "ctrl+alt+e",
				"mac": "ctrl+alt+e",
				"when": "editorLangId == mcode"
			},
			{
				"command": "mcode.previewViz",
				"key": "ctrl+alt+v",
				"mac": "ctrl+alt+v",
				"when": "editorLangId == mcode"
			}
		],
		"semanticTokenScopes": [
			{
				"language": "mcode",
				"scopes": {
					"string": [
						"string.quoted.double.mc"
					],
					"number": [
						"constant.numeric"
					],
					"type": [
						"entity.name.type"
					],
					"class": [
						"entity.name.class"
					],
					"function": [
						"entity.name.function"
					],
					"method": [
						"entity.name.function"
					],
					"interface": [
						"entity.name.interface"
					],
					"enum": [
						"entity.name.enum"
					],
					"enumMember": [
						"entity.name.enum-member"
					],
					"macro": [
						"entity.name.macro"
					],
					"parameter": [
						"variable.parameter"
					],
					"variable": [
						"variable.other"
					],
					"property": [
						"variable.other.property"
					],
					"typeParameter": [
						"entity.name.type.parameter"
					],
					"keyword": [
						"keyword.other"
					],
					"operator": [
						"keyword.operator"
					],
					"comment": [
						"comment.line"
					],
					"regexp": [
						"string.regexp"
					]
				}
			}
		]
	},
	"scripts": {
		"postinstall": "cd client && pnpm i",
		"compile": "npm run check-types && node esbuild.js --production",
		"check-types": "tsc --noEmit",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "vsce package --no-dependencies"
	},
	"devDependencies": {
		"@types/glob": "8.1.0",
		"@types/mocha": "10.0.10",
		"@types/node": "22.10.2",
		"@vscode/vsce": "^3.2.1",
		"cross-env": "^7.0.2",
		"esbuild": "^0.24.2",
		"eslint": "9.17.0",
		"glob": "11.0.0",
		"mocha": "11.0.2",
		"npm-run-all": "^4.1.5",
		"ts-loader": "^9.5.1",
		"typescript": "5.4.5",
		"vscode-test": "^1.4.0",
		"vscode-uri": "^3.0.2"
	},
	"packageManager": "pnpm@8.15.7"
}
